class Solution {
public:
    int hIndex(vector<int>& citations) {
        if(citations.size() == 1 && citations[0] >= 1){
            return 1;
        }
        
        int n = citations.size();
        int left = 0;
        int right = n - 1;
        int ans = 0;

        while(left <= right){
            int mid = (left + right) / 2;

            int count = n - mid;
            if(count == citations[mid]){
                return count;
            }
            else if(count < citations[mid]){
                right = mid - 1;
                ans = count;
            }
            else{
                left = mid + 1;
            }
        }
        return ans;

    }
};
